# Copy to .env and adjust. Defaults run fully offline (no API key needed).

# Providers: "hashing" | "openai"  and  "extractive" | "openai"
RAG_EMBEDDING_PROVIDER=hashing
RAG_LLM_PROVIDER=extractive

# Required only when an "openai" provider is selected. Any OpenAI-compatible endpoint works
# (e.g. Ollama: http://localhost:11434/v1, vLLM, Azure-compatible proxies).
RAG_OPENAI_API_KEY=
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini

# Chunking & retrieval
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
# dense | sparse | hybrid
RAG_RETRIEVAL_MODE=hybrid

# Data
RAG_CORPUS_DIR=data/corpus
RAG_EVAL_PATH=data/eval/qa.jsonl
RAG_INGEST_ON_STARTUP=true
# RAG_INDEX_PATH=index/store.json
